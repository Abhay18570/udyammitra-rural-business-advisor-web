APP_NAME=UdyamMitra API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/udyammitra
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OSM locality lookup is user-triggered, cached, and globally throttled.
# Public Nominatim policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=UdyamMitra-SIH/0.1 (locality and business evidence)
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_MIN_INTERVAL_SECONDS=1.1
GEOCODING_CACHE_TTL_SECONDS=2592000
GEOCODING_NEGATIVE_CACHE_TTL_SECONDS=3600
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25
OVERPASS_QUERY_TIMEOUT_SECONDS=20
OVERPASS_MAX_RESPONSE_BYTES=5000000
OVERPASS_MAX_ELEMENTS=5000
OVERPASS_MAX_CONCURRENT_REQUESTS=1
NEARBY_REQUEST_TIMEOUT_SECONDS=50
NEARBY_CACHE_TTL_SECONDS=86400
NEARBY_EMPTY_CACHE_TTL_SECONDS=3600
NEARBY_STALE_MAX_AGE_SECONDS=604800
GOOGLE_PLACES_API_KEY=

# Explicit nearby discovery provider; Overpass remains the default.
NEARBY_MARKET_PROVIDER=overpass
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1/places:searchNearby
GOOGLE_PLACES_TIMEOUT_SECONDS=15
GOOGLE_PLACES_MAX_RESULTS=20

# Free-text discovery: 20 results/page, at most 2 pages by default (hard cap 3).
GOOGLE_PLACES_TEXT_SEARCH_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_TEXT_MAX_PAGES=2
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MOBILE=
